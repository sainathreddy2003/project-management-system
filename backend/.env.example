# ------------------------------------------------------------------------------
# PMS BACKEND API ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=production

# Database Connection (Individual fields)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=project_management_db

# Cloud Database Connection String (Optional - overrides DB_* if present)
# DATABASE_URL=mysql://user:pass@host:port/dbname
# DB_SSL=true

# Auto-seed database on startup (Optional, handy for initial demo deployments)
# AUTO_SEED=true

# Security
JWT_SECRET=replace-with-a-random-64-character-secret-in-production
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=7

# CORS (Comma-separated origins or wildcard patterns)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app
