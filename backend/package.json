{
  "name": "pms-backend",
  "version": "1.0.0",
  "description": "REST API backend for Project Management System in pure JavaScript",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/scripts/initDb.js",
    "db:seed": "node src/scripts/seed.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.4",
    "uuid": "^11.0.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
