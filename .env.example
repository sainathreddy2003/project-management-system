# ==============================================================================
# PROJECT MANAGEMENT SYSTEM (PMS) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API SERVICE (Node.js / Express)
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=production

# Database Connection - Option A: Individual Variables (Local / Docker)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=project_management_db

# Database Connection - Option B: Cloud PaaS URI (Railway / Render / Aiven / PlanetScale)
# If DATABASE_URL or MYSQL_URL is set, it takes precedence over individual DB_* variables.
# DATABASE_URL=mysql://root:password@roundhouse.proxy.rlwy.net:3306/railway
# DB_SSL=true   # Set to true for cloud-hosted databases requiring TLS/SSL

# Optional: Auto-seed initial demo data upon cloud server startup
# AUTO_SEED=true

# Authentication & Security
JWT_SECRET=replace-with-a-random-64-character-secret-in-production
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=7

# CORS Allowed Origins (Comma-separated list, wildcards supported like *.vercel.app)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app

# ------------------------------------------------------------------------------
# 2. WEB FRONTEND (React / Vite)
# ------------------------------------------------------------------------------
# In production on Vercel/Netlify, set this to your deployed backend URL:
# e.g., https://pms-backend.onrender.com or https://your-backend.up.railway.app
VITE_API_URL=http://localhost:5001/api

# ------------------------------------------------------------------------------
# 3. MOBILE APPLICATION (React Native Expo)
# ------------------------------------------------------------------------------
# Android Emulator uses 10.0.2.2 to reach host machine. For physical devices, use LAN IP.
EXPO_PUBLIC_API_URL=http://10.0.2.2:5001/api
